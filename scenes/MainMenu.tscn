[sub_resource type="GDScript" id="GDScript_ukcvp"]
script/source = "extends Node2D

@onready var easy_streak: Label = %EasyStreak
@onready var hard_streak: Label = %HardStreak
@onready var expert_streak: Label = %ExpertStreak
@onready var master_streak: Label = %MasterStreak
@onready var easy_btn: Button = %Easy
@onready var expert_btn: Button = %Expert
@onready var master_btn: Button = %Master
@onready var hard_btn: Button = %Hard
@onready var easy_crown: Label = %easy_crown
@onready var hard_crown: Label = %hard_crown
@onready var expert_crown: Label = %expert_crown
@onready var master_crown: Label = %master_crown

const SaveSystem = preload(\"res://scripts/SaveSystem.gd\")
const CONFIG_PATH = \"user://settings.cfg\"

var beta_popup_template = preload(\"res://scenes/New_user.tscn\")
var config = ConfigFile.new()
var _buttons: Dictionary
var _crowns: Dictionary


func _ready() -> void:
	_crowns = {
	2: easy_crown,
	3: hard_crown,
	4: expert_crown,
	5: master_crown,
}
	_buttons = {
		2: easy_btn,
		3: hard_btn,
		4: expert_btn,
		5: master_btn,
	}

	update_streak_ui()

	config.load(CONFIG_PATH)
	var has_seen_popup = config.get_value(\"game_state\", \"beta_popup_seen\", false)
	if not has_seen_popup:
		show_beta_popup()
		mark_popup_as_seen()

	_play_entry_pops()
	_update_crown()

	await get_tree().create_timer(0.8).timeout
	_start_highest_streak_bounce()

# ─────────────────────────────────────────
# CROWN — shows on highest streak button only
# ─────────────────────────────────────────
func _update_crown() -> void:
	var highest_streak := 0
	var highest_difficulty := -1

	for difficulty in _buttons:
		var streak: int = SaveSystem.get_streak(difficulty)
		if streak > highest_streak:
			highest_streak = streak
			highest_difficulty = difficulty

	# Hide all crowns first
	for difficulty in _crowns:
		_crowns[difficulty].visible = false

	# Only show crown if there is actually a streak to show
	if highest_streak <= 0:
		return

	_crowns[highest_difficulty].visible = true
# ─────────────────────────────────────────
# ENTRY POP — all buttons on menu load
# ─────────────────────────────────────────
func _play_entry_pops() -> void:
	var delay := 0.0
	for difficulty in _buttons:
		var btn: Button = _buttons[difficulty]
		btn.scale = Vector2(0.8, 0.8)
		btn.pivot_offset = btn.size / 2.0

		var t := create_tween()
		t.tween_interval(delay)
		t.tween_property(btn, \"scale\", Vector2(1.05, 1.05), 0.15) \\
			.set_ease(Tween.EASE_OUT)
		t.tween_property(btn, \"scale\", Vector2(1.0, 1.0), 0.1) \\
			.set_ease(Tween.EASE_IN)

		delay += 0.12


# ─────────────────────────────────────────
# BOUNCE — only on highest streak if ≥ 5
# ─────────────────────────────────────────
func _start_highest_streak_bounce() -> void:
	var highest_streak := 0
	var highest_btn: Button = null

	for difficulty in _buttons:
		var streak: int = SaveSystem.get_streak(difficulty)
		if streak > highest_streak:
			highest_streak = streak
			highest_btn = _buttons[difficulty]

	if highest_streak < 5:
		return

	highest_btn.pivot_offset = highest_btn.size / 2.0

	var t := create_tween()
	t.set_loops()
	t.tween_property(highest_btn, \"scale\", Vector2(1.0, 1.08), 0.4) \\
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	t.tween_property(highest_btn, \"scale\", Vector2(1.0, 1.0), 0.4) \\
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)


# ─────────────────────────────────────────
# STREAK LABELS
# ─────────────────────────────────────────
func update_streak_ui() -> void:
	if easy_streak:
		easy_streak.text = str(SaveSystem.get_streak(2))
	if hard_streak:
		hard_streak.text = str(SaveSystem.get_streak(3))
	if expert_streak:
		expert_streak.text = str(SaveSystem.get_streak(4))
	if master_streak:
		master_streak.text = str(SaveSystem.get_streak(5))


# ─────────────────────────────────────────
# POPUP
# ─────────────────────────────────────────
func show_beta_popup() -> void:
	var popup = beta_popup_template.instantiate()
	add_child(popup)

func mark_popup_as_seen() -> void:
	config.set_value(\"game_state\", \"beta_popup_seen\", true)
	config.save(CONFIG_PATH)


# ─────────────────────────────────────────
# BUTTON HANDLERS
# ─────────────────────────────────────────
func _on_easy_pressed() -> void:
	Settings.DIFFICULTY = 2
	get_tree().change_scene_to_file(\"res://scenes/Game.tscn\")

func _on_hard_pressed() -> void:
	Settings.DIFFICULTY = 3
	get_tree().change_scene_to_file(\"res://scenes/Game.tscn\")

func _on_expert_pressed() -> void:
	Settings.DIFFICULTY = 4
	get_tree().change_scene_to_file(\"res://scenes/Game.tscn\")

func _on_master_pressed() -> void:
	Settings.DIFFICULTY = 5
	get_tree().change_scene_to_file(\"res://scenes/Game.tscn\")

func _on_about_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/about.tscn\")

func _on_button_2_pressed() -> void:
	get_tree().quit()
"

